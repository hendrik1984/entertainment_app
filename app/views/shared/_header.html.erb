<!-- Header -->
<header class="bg-plum">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-6">
    <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
      <span class="w-2.5 h-2.5 rounded-full bg-lime"></span>
      <span class="font-display font-semibold text-xl tracking-tight text-white">Loop</span>
    <% end %>

    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-white/70">
      <a href="#" class="text-white">Home</a>
      <a href="#" class="hover:text-white transition-colors">Trending</a>
      <a href="#" class="hover:text-white transition-colors">Following</a>
      <a href="#" class="hover:text-white transition-colors">Library</a>
    </nav>

    <div class="flex items-center gap-3">
      <label class="relative hidden sm:block">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" placeholder="Search Loop"
          class="bg-white/10 border border-white/15 rounded-full text-sm text-white pl-9 pr-4 py-2 w-52 placeholder:text-white/50 focus:outline-none focus:ring-2 focus:ring-lime/70" />
      </label>
      <button class="w-9 h-9 rounded-full bg-lime flex items-center justify-center text-sm font-semibold text-plum">A</button>
    </div>
  </div>
</header>