<%= turbo_frame_tag "content_area", data: { turbo_action: "advance" } do %>
  <div class="max-w-3xl mx-auto px-5 sm:px-8 py-10">

    <div class="mb-6">
      <%= link_to contents_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-orchid hover:text-plum transition-colors" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Back to library
      <% end %>
    </div>

    <div class="bg-white border-2 border-line rounded-none p-8">
      <% if @content.video.attached? %>
        <div class="mb-6">
          <%= video_tag url_for(@content.video),
                        controls: true,
                        disablePictureInPicture: true,
                        controlsList: "nopictureinpicture",
                        class: "w-full bg-paper border-2 border-line rounded-none aspect-video" %>
        </div>
      <% end %>

      <h1 class="font-display font-semibold text-3xl text-ink mb-4">
        <%= @content.title %>
      </h1>

      <p class="text-inksoft whitespace-pre-line leading-relaxed mb-6">
        <%= @content.description %>
      </p>

      <p class="text-inksoft whitespace-pre-line leading-relaxed mb-6">
        <%= @content.created_at.strftime("%B %d, %Y") %>
      </p>

      <div class="border-t border-line pt-6 flex items-center gap-3">
        <%= link_to "Edit",
                    edit_content_path(@content),
                    class: "bg-ink text-white text-sm font-medium px-5 py-2.5 rounded-none hover:bg-plum transition-colors" %>
        
        <%= button_to "Delete",
              @content,
              method: :delete,
              class: "bg-white text-red-600 text-sm font-medium px-5 py-2.5 rounded-none border-2 border-red-600 hover:bg-red-600 hover:text-white transition-colors cursor-pointer",
              form: {
                data: {
                  turbo_confirm: "Are you sure you want to delete this content?",
                  turbo_frame: "_top"
                }
              } %>

        <%= link_to "Back",
                    contents_path,
                    class: "text-sm font-medium text-inksoft hover:text-orchid transition-colors px-4 py-2.5" %>
      </div>
    </div>

  </div>
<% end %>