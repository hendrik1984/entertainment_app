<main class="max-w-6xl mx-auto px-5 sm:px-8 py-10">
  <!-- Featured video -->
  <section class="mb-12">
    <p class="text-sm font-medium text-orchid mb-3">Picked for your evening</p>
    <div class="grid md:grid-cols-2 gap-6 items-stretch">
      <div class="card group cursor-pointer">
        <div class="border-2 border-line overflow-hidden aspect-video bg-gradient-to-br from-orchid to-plum relative transition-colors">
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="w-16 h-16 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
              <rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 4v14M16 4v14M3 9h5M16 9h5M3 13h5M16 13h5"/>
            </svg>
          </div>
          <span class="absolute bottom-3 right-3 text-xs font-medium bg-ink/70 text-white px-2 py-0.5 rounded">2:31</span>
        </div>
      </div>

      <div class="flex flex-col justify-center">
        <span class="inline-flex w-fit items-center text-xs font-medium bg-mint/40 text-plum px-2.5 py-1 rounded-full mb-3">Trailer</span>
        <h1 class="font-display font-semibold text-3xl leading-tight text-ink mb-3">Glass Horizon — Official Trailer</h1>
        <p class="text-inksoft text-sm mb-5 max-w-md">A city suspended in ice starts to thaw, and everyone who left has a reason to come back.</p>
        <div class="flex items-center gap-4 text-sm text-inksoft mb-6">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            310K views
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            5 days ago
          </span>
        </div>
        <div class="flex items-center gap-3">
          <button class="flex items-center gap-2 bg-ink text-white text-sm font-medium px-5 py-2.5 rounded-full hover:bg-plum transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            Play
          </button>
          <button class="like-btn flex items-center gap-2 border border-line text-sm font-medium px-4 py-2.5 rounded-full text-inksoft hover:border-orchid hover:text-orchid transition-colors"
            data-likes="5920" data-liked="false">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.8 8.6c0 3.7-3.4 6.2-8.8 11.4C6.6 14.8 3.2 12.3 3.2 8.6 3.2 5.9 5.4 4 8 4c1.7 0 3.2.9 4 2.3C12.8 4.9 14.3 4 16 4c2.6 0 4.8 1.9 4.8 4.6z"/>
            </svg>
            <span class="like-count">5,920</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section>
    <div class="flex items-end justify-between mb-6">
      <h2 class="font-display font-semibold text-xl text-ink">More to watch</h2>
      <button class="text-sm text-orchid hover:text-plum transition-colors">See all</button>
    </div>

    <% if @contents.any? %>
      <div id="video-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <% @contents.each do |content| %>
          <%= turbo_stream_from content, class: "hidden" %>

          <%= link_to content_path(content), class: "card group block" do %>
            <div class="border-2 border-line overflow-hidden aspect-video relative transition-colors hover:border-orchid">
              <% if content.video.attached? %>
                <%= video_tag url_for(content.video),
                              class: "w-full h-full object-cover",
                              muted: true,
                              preload: "metadata" %>
              <% else %>
                <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-orchid to-plum">
                  <svg class="w-10 h-10 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                    <rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 4v14M16 4v14M3 9h5M16 9h5M3 13h5M16 13h5"/>
                  </svg>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="pt-3">
            <span class="text-[11px] font-medium text-orchid">no category</span>
            <h3 class="font-display font-semibold text-[15px] leading-snug text-ink clamp-2 mt-0.5"><%= content.title %></h3>

            <div class="flex items-center justify-between mt-2.5">
              <div class="flex items-center gap-2.5 text-xs text-inksoft">
                <span>X views</span>
                <span><%= content.created_at.strftime("%b %d, %Y") %></span>
              </div>
              <%= button_to like_content_path(content),
                      method: :post,
                      class: "flex items-center gap-1.5 text-xs font-medium text-inksoft bg-white border border-line rounded-full pl-2.5 pr-3 py-1.5 hover:border-orchid hover:text-orchid transition-colors cursor-pointer",
                      form: { class: "inline-flex shrink-0" } do %>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.8 8.6c0 3.7-3.4 6.2-8.8 11.4C6.6 14.8 3.2 12.3 3.2 8.6 3.2 5.9 5.4 4 8 4c1.7 0 3.2.9 4 2.3C12.8 4.9 14.3 4 16 4c2.6 0 4.8 1.9 4.8 4.6z"/>
                </svg>

                <%= render "contents/like_count", content: content %>

              <% end %>
            </div>

          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white border-2 border-line rounded-none text-center py-16 px-6">
        <h2 class="font-display font-semibold text-xl text-ink mb-2">No videos yet</h2>
        <p class="text-inksoft mb-6">There are no videos available yet.</p>
        <%= link_to "Create Content",
                    new_content_path,
                    class: "inline-block bg-ink text-white text-sm font-medium px-5 py-2.5 rounded-none hover:bg-plum transition-colors" %>
      </div>
    <% end %>
  </section>
</main>